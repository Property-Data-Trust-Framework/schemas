          "format": "date-time"
        },
        "completed": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "completion": {
      "type": "object",
      "properties": {
        "started": {
          "type": "string",
          "format": "date-time"
        },
        "expected": {
          "type": "string",
          "format": "date-time"
        },
        "completed": {
          "type": "string",
          "format": "date-time"
        }
      }
    }

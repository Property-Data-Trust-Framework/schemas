{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transaction Milestones",
  "description": "Schema for tracking transaction milestones throughout the conveyancing process",
  "type": "object",
  "properties": {
    "listed": {
      "type": "object",
      "properties": {
        "completed": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "legalForms": {
      "type": "object",
      "properties": {
        "completed": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "soldSubjectToContract": {
      "type": "object",
      "properties": {
        "completed": {
          "type": "string",
          "format": "date-time"
        }
      }
